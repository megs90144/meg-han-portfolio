:root[data-theme="dark"]{--bg:#1F211A;--paper:#272A20;--sand:#33362A;--olive:#A3AA8A;--olive-d:#C9CFB4;--ink:#EDE8DA;--muted:#B0AE9F;--clay:#E0997A;--gold:#C7AE7D;--line:#3C4031;--on-olive:#1F211A;color-scheme:dark}
html{scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px));overflow-x:clip}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.8 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,p,ul{margin:0}ul{padding:0;list-style:none}a{color:inherit}
:focus-visible{outline:2px solid var(--clay);outline-offset:3px}
.wrap{max-width:1100px;margin:0 auto;padding-inline:clamp(18px,4vw,40px)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:49}
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--bg);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:62px;gap:16px}
.brand{font:400 30px/1 var(--script);color:var(--olive-d);text-decoration:none;white-space:nowrap}
.nav ul{display:flex;gap:clamp(12px,2.4vw,30px);font-size:14px;letter-spacing:.08em}
.nav ul a{text-decoration:none;color:var(--muted);padding:6px 0;border-bottom:1px solid transparent}
.nav ul a:hover{color:var(--ink);border-color:var(--clay)}
@media(max-width:720px){.nav ul{display:none}}
.hero{padding-block:clamp(40px,7vw,90px)}
.hero .wrap{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(28px,5vw,70px);align-items:center}
.hello{font:400 clamp(32px,4vw,48px)/1 var(--script);color:var(--gold);margin-bottom:8px}
h1{font:500 clamp(60px,10vw,128px)/.88 var(--serif);color:var(--olive-d);letter-spacing:-.01em}
h1 span{display:block}h1 .l2{padding-left:.5em;font-style:italic;color:var(--clay)}
.cn{font:700 clamp(20px,2.2vw,26px)/1.3 var(--cjk);letter-spacing:.3em;margin-top:22px}
.role{margin-top:8px;font-size:14px;letter-spacing:.2em;color:var(--gold);font-weight:500}
.lead{margin-top:20px;max-width:34em;color:var(--muted)}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.btn{display:inline-block;padding:12px 24px;font-size:14px;letter-spacing:.14em;text-decoration:none;border:1px solid var(--olive-d);transition:background .25s,color .25s}
.btn.solid{background:var(--olive-d);color:var(--on-olive)}.btn:hover{background:var(--clay);border-color:var(--clay);color:#fff}
.portrait{position:relative;justify-self:center;width:min(100%,360px)}
.arch{aspect-ratio:4/5;border-radius:999px 999px 0 0;background:var(--sand);position:relative;z-index:1;display:grid;place-items:center;overflow:hidden}
.arch b{font:500 140px/1 var(--script);color:var(--olive);font-weight:400}
.arch img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.arch-line{position:absolute;inset:-14px -14px 14px 14px;border:1px solid var(--gold);border-radius:999px 999px 0 0}
.badge{position:absolute;right:-26px;bottom:44px;z-index:2;width:120px;height:120px;border-radius:50%;background:var(--paper);display:grid;place-items:center;text-align:center;border:1px solid var(--line);font:500 13px/1.35 var(--sans);color:var(--olive-d)}
.badge em{display:block;font:500 40px/1 var(--serif);font-style:normal;color:var(--clay)}
@media(max-width:820px){.hero .wrap{grid-template-columns:1fr}.portrait{width:min(76%,320px)}.badge{right:-12px}}
.sec{padding-block:clamp(48px,7vw,96px)}.alt{background:var(--paper)}
h2{font:700 clamp(26px,3.4vw,36px)/1.3 var(--cjk);color:var(--olive-d);margin-bottom:10px}
.sub{color:var(--muted);margin-bottom:36px;max-width:40em}
.about{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px)}
@media(max-width:820px){.about{grid-template-columns:1fr}}
.about p+p{margin-top:14px}
.facts li{display:flex;gap:18px;padding:12px 0;border-bottom:1px solid var(--line)}
.facts li b{flex:0 0 5.5em;color:var(--gold);font-weight:500}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
@media(max-width:900px){.stats{grid-template-columns:repeat(2,1fr)}}
.stat{border-top:2px solid var(--olive);padding:16px 4px 0}
.stat .n{font:500 clamp(44px,5.6vw,68px)/1 var(--serif);color:var(--clay)}
.stat h3{font-size:17px;margin:8px 0 4px;color:var(--olive-d)}
.stat p{font-size:14px;color:var(--muted);line-height:1.7}
.note{margin-top:22px;font-size:14px;color:var(--muted)}
.duty{display:grid;grid-template-columns:repeat(2,1fr);gap:0 clamp(24px,5vw,64px)}
@media(max-width:820px){.duty{grid-template-columns:1fr}}
.duty li{padding:16px 0;border-bottom:1px solid var(--line)}
.duty h3{font-size:17px;color:var(--olive-d);margin-bottom:2px}
.duty p{font-size:15px;color:var(--muted);line-height:1.75}
.brands{margin-top:30px;padding:20px 24px;background:var(--bg);border-left:3px solid var(--clay);font-size:15px}
.tl{position:relative;padding-left:28px;border-left:1px solid var(--gold)}
.job{position:relative;padding-bottom:40px}
.job::before{content:"";position:absolute;left:-34px;top:9px;width:11px;height:11px;border-radius:50%;background:var(--clay);border:2px solid var(--bg)}
.job .when{font:500 15px var(--serif);color:var(--gold);letter-spacing:.05em}
.job h3{font-size:20px;margin:2px 0;color:var(--olive-d)}
.job .co{color:var(--muted);font-size:15px;margin-bottom:10px}
.job ul li{position:relative;padding-left:1.1em;font-size:15px;line-height:1.75;color:var(--ink)}
.job ul li::before{content:"–";position:absolute;left:0;color:var(--gold)}
.steps{display:flex;gap:10px;flex-wrap:wrap;margin:6px 0 14px}
.steps span{font-size:13px;padding:3px 12px;border:1px solid var(--olive);color:var(--olive-d)}
.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,4vw,48px)}
@media(max-width:820px){.skills{grid-template-columns:1fr}}
.skills h3{font-size:17px;color:var(--olive-d);padding-bottom:8px;border-bottom:1px solid var(--olive);margin-bottom:12px}
.skills li{font-size:15px;padding:3px 0;color:var(--muted)}
.contact{background:var(--olive-d);color:var(--on-olive);text-align:center;padding-block:clamp(56px,8vw,100px)}
